  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "repository": { "type": "git", "url": "git+https://github.com/adebayomoses/paycryt.git", "directory": "packages/core" },
  "homepage": "https://github.com/adebayomoses/paycryt#readme",
  "bugs": { "url": "https://github.com/adebayomoses/paycryt/issues" },
  "keywords": ["crypto", "payments", "usdt", "stablecoin", "non-custodial", "xpub", "hd-wallet", "tron", "ethereum", "bitcoin", "offline-first", "pos", "africa", "nigeria"],
