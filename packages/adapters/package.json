{
  "name": "@paycryt/adapters",
  "version": "0.1.0",
  "description": "Optional Paycryt adapters: live Tron/EVM/Bitcoin chain watchers, CoinGecko/Binance rate sources, Paystack and Flutterwave rails, a node:sqlite store and an IndexedDB store for browser POS devices.",
  "license": "MIT",
  "author": "Adebayo Moses (https://github.com/adebayomoses)",
  "type": "module",
  "main": "./dist/index.js",
