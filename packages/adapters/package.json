  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=22.5.0" },
  "repository": { "type": "git", "url": "git+https://github.com/adebayomoses/paycryt.git", "directory": "packages/adapters" },
  "homepage": "https://github.com/adebayomoses/paycryt/blob/main/docs/adapters.md",
  "bugs": { "url": "https://github.com/adebayomoses/paycryt/issues" },
  "keywords": ["crypto", "payments", "trongrid", "usdt", "esplora", "json-rpc", "paystack", "flutterwave", "mobile-money", "indexeddb", "sqlite"],
  "publishConfig": { "access": "public", "tag": "alpha" },
  "scripts": { "prepublishOnly": "node ../../scripts/release-check.mjs" },
  "dependencies": { "@paycryt/core": "^0.1.0" },
  "devDependencies": { "fake-indexeddb": "^6.0.0" }
