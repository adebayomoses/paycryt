{
  "name": "paycryt",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, self-hostable crypto payments toolkit built for unstable networks and local fiat rails.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b && node packages/server/scripts/build-pos.mjs",
    "test": "vitest run",
    "sandbox": "node packages/server/dist/cli.js",
    "demo:offline": "node examples/offline-pos/dist/index.js",
    "e2e:pos": "node packages/server/scripts/e2e-pos.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:smoke": "node scripts/release-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
